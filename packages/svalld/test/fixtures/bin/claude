#!/usr/bin/env node
// Test double for `claude` on PATH, so a test never spends the real account: answers its version, its sign-in and the usage
// control request, fails a resume as the real one fails a session it does not hold, and exits quietly for anything else svalld might spawn.
import readline from 'node:readline';

const args = process.argv.slice(2);
if (args[0] === '--version') { process.stdout.write('2.1.283 (Claude Code)\n'); process.exit(0); }
if (args[0] === 'auth') { process.stdout.write('{"loggedIn":true}\n'); process.exit(0); }
const resume = args.indexOf('--resume');
if (resume !== -1) {
  await new Promise((done) => process.stderr.write(`No conversation found with session ID: ${args[resume + 1]}\n`, done));
  process.exit(1);
}

const at = (ms) => new Date(Date.now() + ms).toISOString();
// half an hour off the hour, so a countdown asserted in whole hours does not turn over mid-test
const week = 4 * 86_400_000 + 9 * 3_600_000 + 1_800_000;

const usage = {
  subscription_type: 'max',
  rate_limits_available: true,
  rate_limits: {
    five_hour: { utilization: 35, resets_at: at(2 * 3_600_000) },
    seven_day: { utilization: 56, resets_at: at(week) },
    model_scoped: [{ display_name: 'Fable', utilization: 52, resets_at: at(week) }],
  },
};

for await (const line of readline.createInterface({ input: process.stdin })) {
  let msg;
  try { msg = JSON.parse(line); } catch { continue; }
  if (msg?.request?.subtype !== 'get_usage') continue;
  process.stdout.write(JSON.stringify({
    type: 'control_response',
    response: { subtype: 'success', request_id: msg.request_id, response: usage },
  }) + '\n');
}
