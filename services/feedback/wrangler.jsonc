{
  "name": "svall-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "svall.dev/api/feedback", "zone_name": "svall.dev" }],
  "vars": { "FEEDBACK_REPO": "linusroxbergh/svall-feedback" },
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
