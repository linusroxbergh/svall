{
  "name": "svall-feedback",
  "account_id": "4518483d318c36043e137e17e7fea694",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "svall.dev/api/feedback", "zone_name": "svall.dev" }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "FEEDBACK_REPO": "linusroxbergh/svall-feedback", "FEEDBACK_ENABLED": "true" },
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "SUBMISSION_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "FeedbackBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FeedbackBudget"] }],
  "observability": { "enabled": true }
}
