# Ground, ink and cursor are the page's tokens.css --surface-0, --ink and --sand. Loaded
# over your own Ghostty config, so your font, keybinds and ANSI palette stay yours.
background = 172029
foreground = F4EEDF
cursor-color = E6D8B8
cursor-text = 172029
# the selection is --sel at 25% over --surface-0, the tint the editor and the phone's terminal draw
selection-background = 354C5F
selection-foreground = F4EEDF
# Every terminal attaches to its robot's tmux session, so your own first
# command and startup input are cleared rather than run or typed there.
initial-command =
input =
