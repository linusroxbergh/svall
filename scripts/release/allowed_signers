# The keys whose signature over a release's SHA256SUMS an installer accepts, each under the principal svall-release.
#
# The release key signs every release; the backup key stays offline and takes over when the release key is retired.
# Every release carries this file, and a machine checks an upgrade against the copy its installed release carries;
# see docs/security/workers.md, "Release integrity". A key's line is made from its public half:
#
#   printf 'svall-release namespaces="svall-release" %s\n' "$(cut -d' ' -f1,2 <key>.pub)"

# the release key, held by the SVALL_RELEASE_KEY secret and the publishing Mac
svall-release namespaces="svall-release" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDRMSuPhIR4HJVP/fjj1SjXnpa0WiO0/Z2YRIQbsCQYA
# the backup key, kept offline
svall-release namespaces="svall-release" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHkB/3DCO/O87XCGgZcVcR4qUcu9nmzZm/TY70c9jOvc
