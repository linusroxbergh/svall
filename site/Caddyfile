:8080 {
	root * /srv/svall.dev
	# Svall.dmg moves to each new release, and Cloudflare caches .dmg files by default, so only versioned DMGs are immutable
	@fresh path /appcast.xml /latest.json /install.sh /releases/Svall.dmg
	header @fresh Cache-Control "no-cache"
	# the landing page and its scripts keep their names across deploys, so each load checks them: a cached script
	# against a newer page breaks the page
	@page path / /index.html /map/*
	header @page Cache-Control "no-cache"
	# only a DMG on disk: a 404 marked immutable stays cached after the release uploads it
	@dmg {
		path_regexp ^/releases/Svall-.+\.dmg$
		file
	}
	header @dmg Cache-Control "public, max-age=31536000, immutable"
	# Caddy has no type for .dmg and sends none, which browsers under nosniff show as text
	@disk path /releases/*.dmg
	header @disk Content-Type application/x-apple-diskimage
	redir /download /releases/Svall.dmg 302
	file_server
}
