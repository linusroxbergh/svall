{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": { "entry": ["scripts/**/*.{mjs,js}", "test/*.test.ts"] },
    "packages/cli": { "entry": ["test/fixtures/*.{mjs,ts}"] },
    "packages/svalld": { "entry": ["hooks/*.{mjs,js}", "test/fixtures/*.{mjs,cjs}"] }
  },
  "ignoreFiles": ["**/*.d.mts"],
  "ignoreBinaries": ["ar", "ditto", "hdiutil", "iconutil", "infocmp", "magick", "mkfifo", "pmset", "script", "shasum", "sips", "ssh-keygen", "swiftc"],
  "ignoreExportsUsedInFile": { "type": true, "interface": true }
}
